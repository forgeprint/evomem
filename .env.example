# Copy to .env and fill in. .env is not committed.
#
# The server refuses to serve an endpoint whose secret is missing, rather
# than serving it open (ADR-0010), so an empty value here means that feature
# is off — not that it is unprotected.

# The database's password. Any long random string; it never leaves this
# machine, because the port is published on loopback only. The server keeps
# the notes themselves in this database (ADR-0028).
POSTGRES_PASSWORD=

# The bearer token every write and read endpoint is behind. This is what the
# phone and the web app put in their settings.
EVOMEM_API_TOKEN=

# Exactly 32 bytes. What seals the API tokens and model keys the panel
# stores (ADR-0025, ADR-0027). Losing it means entering every one of them
# again, so keep it somewhere you would keep a password.
EVOMEM_SECRET_KEY=

# Where the web app is served. The server allows this origin and no other;
# change both together if you publish the web service on another port.
EVOMEM_CORS_ORIGIN=http://localhost:8080

# Optional. Each is off while empty.
EVOMEM_PROJECT=default
EVOMEM_TELEGRAM_SECRET=
EVOMEM_TELEGRAM_PROJECT=
EVOMEM_JIRA_SECRET=
EVOMEM_JIRA_PROJECT=

# Ports on the host. All published on 127.0.0.1.
WEB_PORT=8080
EVOMEM_PORT=8787
POSTGRES_PORT=5432
